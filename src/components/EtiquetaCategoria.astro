---
import { buscarCategoria, textoCategoria, type ClaveCategoria } from '../data/categorias';
import { idiomaDe, textos } from '../i18n';
import { rutaCategoria } from '../lib/rutas';

interface Props {
  clave: ClaveCategoria;
  /** Muestra la etiqueta "Eléctrico", el único uso de --ev. */
  electrico?: boolean;
}

const { clave, electrico = false } = Astro.props;
const categoria = buscarCategoria(clave);
const idioma = idiomaDe(Astro.url);
---

<div>
  <div class="flex items-center gap-3">
    <a
      href={rutaCategoria(categoria, 1, idioma)}
      class="t-meta relative z-10 -my-3.5 inline-flex min-h-11 items-center tracking-[0.5px] text-accent uppercase hover:underline"
    >
      {textoCategoria(categoria, idioma).nombre}
    </a>
    {
      (electrico || categoria.electrica) && (
        <span class="t-meta rounded-full border border-ev px-2 py-0.5 text-ev">{textos(idioma).nota.electrico}</span>
      )
    }
  </div>
  <span class="mt-1.5 block h-[3px] w-8 bg-accent-bright" aria-hidden="true"></span>
</div>
