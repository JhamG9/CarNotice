---
import ImagenNota from './ImagenNota.astro';
import EtiquetaCategoria from './EtiquetaCategoria.astro';
import PieNota from './PieNota.astro';
import { enlaceNota, type Nota } from '../lib/notas';

interface Props {
  nota: Nota;
  /** Nivel del titular; en la portada va bajo el h2 "Blog y noticias". */
  nivel?: 'h2' | 'h3';
}

const { nota, nivel: Titular = 'h2' } = Astro.props;
const { titulo, resumen, autor, fecha, categoria, electrico, imagen, imagenAlt } = nota.data;
---

<article class="relative border-b border-border pb-6">
  <ImagenNota imagen={imagen} alt={imagenAlt} prioritaria />
  <div class="mt-4">
    <EtiquetaCategoria clave={categoria} electrico={electrico} />
    <Titular class="t-tarjeta md:t-articulo mt-3">
      <a href={enlaceNota(nota)} class="enlace-titular after:absolute after:inset-0">
        {titulo}
      </a>
    </Titular>
    <p class="t-texto mt-3 text-muted">{resumen}</p>
    <PieNota autor={autor} fecha={fecha} href={enlaceNota(nota)} />
  </div>
</article>
