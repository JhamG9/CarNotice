---
import { getCollection } from 'astro:content';
import PaginaComparacion from '../../../layouts/PaginaComparacion.astro';
import type { Par } from '../../../lib/catalogo';
import { obtenerCatalogo } from '../../../lib/catalogoDatos';

export async function getStaticPaths() {
  const { pares } = await obtenerCatalogo();
  // Un texto cuyo par ya no existe (un carro despublicado, un cambio de tamaño) no se publica: se avisa.
  const slugs = new Set(pares.map((par) => par.slug));
  for (const texto of await getCollection('comparaciones')) {
    if (!slugs.has(texto.id)) console.warn(`[comparaciones] ${texto.id}.md no corresponde a ninguna comparación generada.`);
  }
  return pares.map((par) => ({ params: { par: par.slug }, props: { par } }));
}

interface Props {
  par: Par;
}
---

<PaginaComparacion par={Astro.props.par} />
