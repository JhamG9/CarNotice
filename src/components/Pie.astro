---
import { categorias } from '../data/categorias';
import { rutaAvisoLegal, rutaCarros, rutaCategoria, rutaComparador, rutaInicio, rutaNosotros, rutaPrivacidad } from '../lib/rutas';

const anio = new Date().getFullYear();
const paginasCarros = [
  { nombre: 'Fichas técnicas', href: rutaCarros() },
  { nombre: 'Comparador', href: rutaComparador() },
];
const paginasSitio = [
  { nombre: 'Nosotros', href: rutaNosotros() },
  { nombre: 'Aviso legal', href: rutaAvisoLegal() },
  { nombre: 'Política de privacidad', href: rutaPrivacidad() },
  { nombre: 'Cookies', href: `${rutaPrivacidad()}#cookies` },
];
---

<footer class="mt-16 border-t border-border bg-surface">
  <div class="mx-auto grid max-w-pagina gap-8 px-4 py-10 md:grid-cols-[2fr_1fr_1fr_1fr] md:px-6">
    <div>
      <p class="font-titular text-[24px] leading-none font-bold">
        <a href={rutaInicio()} class="inline-flex min-h-11 items-center">
          Mejor Eléctrico<span class="text-accent-bright" aria-hidden="true">.</span>
        </a>
      </p>
      <p class="mt-2 max-w-[46ch] text-muted">
        Revista de carros: noticias, lanzamientos, eléctricos y pruebas para quienes disfrutan manejar.
      </p>
    </div>

    <nav aria-label="Carros en el pie">
      <h2 class="t-menu text-muted">Carros</h2>
      <ul class="mt-2">
        {
          paginasCarros.map((pagina) => (
            <li>
              <a href={pagina.href} class="enlace flex min-h-11 items-center">
                {pagina.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Categorías en el pie">
      <h2 class="t-menu text-muted">Categorías</h2>
      <ul class="mt-2">
        {
          categorias.map((categoria) => (
            <li>
              <a href={rutaCategoria(categoria)} class="enlace flex min-h-11 items-center">
                {categoria.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Sobre el sitio">
      <h2 class="t-menu text-muted">Sobre el sitio</h2>
      <ul class="mt-2">
        {
          paginasSitio.map((pagina) => (
            <li>
              <a href={pagina.href} class="enlace flex min-h-11 items-center">
                {pagina.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-border">
    <p class="t-meta mx-auto max-w-pagina px-4 py-4 text-muted md:px-6">
      © {anio} Mejor Eléctrico. Todos los derechos reservados.
    </p>
  </div>
</footer>
