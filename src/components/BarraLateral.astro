---
import Etiquetas from './Etiquetas.astro';
import { categorias, textoCategoria } from '../data/categorias';
import { LOCALE, idiomaDe, textos } from '../i18n';
import { enlaceNota, type Nota } from '../lib/notas';
import { fechaISO, formatearFecha } from '../lib/fechas';
import { rutaCategoria } from '../lib/rutas';

interface Props {
  notas: Nota[];
}

const { notas } = Astro.props;
const idioma = idiomaDe(Astro.url);
const t = textos(idioma).lateral;
const recientes = notas.slice(0, 5);
const conteo = (clave: string) => notas.filter((nota) => nota.data.categoria === clave).length;
const etiquetas = [...new Set(notas.flatMap((nota) => nota.data.etiquetas))].sort((a, b) =>
  a.localeCompare(b, LOCALE[idioma]),
);
---

<aside aria-label={t.aria} class="grid content-start gap-10 md:grid-cols-2 lg:grid-cols-1">
  <section aria-labelledby="titulo-recientes" class="md:col-span-2 lg:col-span-1">
    <h2 id="titulo-recientes" class="t-lateral barra-corta">{t.recientes}</h2>
    <ol class="mt-2">
      {
        recientes.map((nota) => (
          <li class="border-b border-border">
            <a href={enlaceNota(nota)} class="t-item enlace-titular block pt-4 pb-1">
              {nota.data.titulo}
            </a>
            <time datetime={fechaISO(nota.data.fecha)} class="t-meta block pb-4 text-muted">
              {formatearFecha(nota.data.fecha, idioma)}
            </time>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="titulo-categorias">
    <h2 id="titulo-categorias" class="t-lateral barra-corta">{t.categorias}</h2>
    <ul class="mt-2">
      {
        categorias.map((categoria) => (
          <li class="border-b border-border">
            <a
              href={rutaCategoria(categoria, 1, idioma)}
              class="t-item enlace flex min-h-12 items-center justify-between gap-4"
            >
              {textoCategoria(categoria, idioma).nombre}
              <span class="t-meta text-muted" aria-label={t.notas(conteo(categoria.clave))}>
                {conteo(categoria.clave)}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="titulo-etiquetas">
    <h2 id="titulo-etiquetas" class="t-lateral barra-corta">{t.etiquetas}</h2>
    <div class="mt-4">
      <Etiquetas etiquetas={etiquetas} />
    </div>
  </section>
</aside>
