---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BarraLateral from '../components/BarraLateral.astro';
import Compartir from '../components/Compartir.tsx';
import EtiquetaCategoria from '../components/EtiquetaCategoria.astro';
import Etiquetas from '../components/Etiquetas.astro';
import ImagenNota from '../components/ImagenNota.astro';
import TarjetaRelacionada from '../components/TarjetaRelacionada.astro';
import { buscarCategoria, textoCategoria } from '../data/categorias';
import { fechaISO, formatearFecha } from '../lib/fechas';
import CuerpoTraducido from '../components/CuerpoTraducido.astro';
import { LOCALE, textos } from '../i18n';
import {
  enlaceNota,
  idiomaDeNota,
  notasRelacionadas,
  obtenerNotas,
  slugOriginal,
  tiempoDeLectura,
  traduccionesDeNotas,
  type Nota,
} from '../lib/notas';
import { obtenerCatalogo } from '../lib/catalogoDatos';
import { rutaModelo } from '../lib/rutas';

/** Plantilla de una nota, en cualquier idioma. La usan /es/notas/<slug>/ y /en/news/<slug>/. */
interface Props {
  nota: Nota;
}

const { nota } = Astro.props;
const { titulo, resumen, autor, fecha, categoria, etiquetas, electrico, imagen, imagenAlt, imagenPie, imagenCredito } =
  nota.data;
const { Content } = await render(nota);

const idioma = idiomaDeNota(nota);
const t = textos(idioma).nota;
const traducciones = await traduccionesDeNotas();
const alternativas = traducciones.get(slugOriginal(nota)) ?? {};
const notas = await obtenerNotas(idioma);
const relacionadas = notasRelacionadas(nota, notas);

// Modelos de los que habla la nota: los que la enlazan desde su ficha o aparecen en el titular
const { modelos } = await obtenerCatalogo();
const modelosDeLaNota = modelos
  .filter(
    (modelo) =>
      modelo.versiones.some((v) => v.article_slug === slugOriginal(nota)) || titulo.toLowerCase().includes(modelo.nombre.toLowerCase()),
  )
  .slice(0, 3);
const minutos = tiempoDeLectura(nota);
const url = new URL(enlaceNota(nota), Astro.site).href;
const imagenSocial = imagen
  ? new URL((await getImage({ src: imagen, width: 1200, height: 630, format: 'jpeg' })).src, Astro.site).href
  : undefined;

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: titulo,
  description: resumen,
  datePublished: fecha.toISOString(),
  dateModified: fecha.toISOString(),
  inLanguage: LOCALE[idioma],
  articleSection: textoCategoria(buscarCategoria(categoria), idioma).nombre,
  keywords: etiquetas.join(', '),
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  author: { '@type': 'Person', name: autor },
  publisher: { '@type': 'Organization', name: 'Mejor Eléctrico', url: new URL('/', Astro.site).href },
  ...(imagenSocial && { image: [imagenSocial] }),
};
// "<" escapado para que el texto de una nota no pueda cerrar la etiqueta <script>
// El nombre del sitio solo se añade si el título completo no pasa de 60 caracteres, que es lo que muestra Google
const conMarca = `${titulo} | Mejor Eléctrico`;
const tituloPagina = conMarca.length <= 60 ? conMarca : titulo;

const jsonLd = JSON.stringify(datosEstructurados).replace(/</g, '\\u003c');
---

<Base titulo={tituloPagina} descripcion={resumen} seccionActiva={categoria} tipo="article" imagenSocial={imagenSocial} alternativas={alternativas}>
  <Fragment slot="head">
    <meta property="article:published_time" content={fecha.toISOString()} />
    <meta property="article:author" content={autor} />
    <meta property="article:section" content={textoCategoria(buscarCategoria(categoria), idioma).nombre} />
    {etiquetas.map((etiqueta) => <meta property="article:tag" content={etiqueta} />)}
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </Fragment>

  <div
    class="mx-auto grid max-w-pagina gap-12 px-4 pt-6 md:px-6 md:pt-8 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-10 xl:gap-14"
  >
    <div class="min-w-0">
      <article class="max-w-articulo">
        <header>
          <EtiquetaCategoria clave={categoria} electrico={electrico} />
          <h1 class="mt-4 font-titular text-[30px] leading-[38px] font-semibold md:t-articulo">{titulo}</h1>
          <p class="t-texto mt-4 text-muted">{resumen}</p>
          <p class="mt-4 text-[14px] leading-5 text-muted">
            {t.por} <span class="font-bold text-heading">{autor}</span>
            <span aria-hidden="true"> · </span>
            <time datetime={fechaISO(fecha)}>{formatearFecha(fecha, idioma)}</time>
            <span aria-hidden="true"> · </span>
            {t.minutos(minutos)}
          </p>
        </header>

        <figure class="mt-6">
          <ImagenNota imagen={imagen} alt={imagenAlt} prioritaria />
          {
            (imagenPie || imagenCredito) && (
              <figcaption class="mt-2 text-[14px] leading-5 text-muted">
                {imagenPie}
                {imagenCredito && <span> {t.foto} {imagenCredito}.</span>}
              </figcaption>
            )
          }
        </figure>

        <div class="cuerpo-nota mt-8">
          {
            idioma === 'es' ? (
              <Content />
            ) : (
              <CuerpoTraducido idioma={idioma} traducciones={traducciones}>
                <Content />
              </CuerpoTraducido>
            )
          }
        </div>

        {
          modelosDeLaNota.length > 0 && (
            <aside aria-labelledby="titulo-fichas" class="mt-10 rounded-lg border border-border bg-surface p-5 md:p-6">
              <h2 id="titulo-fichas" class="t-lateral barra-corta">
                {t.fichas}
              </h2>
              <ul class="mt-4 grid gap-2">
                {modelosDeLaNota.map((modelo) => (
                  <li>
                    <a href={rutaModelo(modelo.slug, idioma)} class="inline-flex min-h-11 items-center text-[17px] font-bold text-accent hover:underline">
                      {t.enlaceFicha(modelo.nombre)}
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }

        <footer class="mt-12 grid gap-8 border-t border-border pt-8">
          <section aria-labelledby="titulo-etiquetas-nota">
            <h2 id="titulo-etiquetas-nota" class="t-lateral barra-corta">{t.etiquetas}</h2>
            <div class="mt-4">
              <Etiquetas etiquetas={etiquetas} />
            </div>
          </section>

          <section aria-labelledby="titulo-compartir">
            <h2 id="titulo-compartir" class="t-lateral barra-corta">{t.compartir}</h2>
            <div class="mt-4">
              <Compartir titulo={titulo} url={url} textos={textos(idioma).compartir} client:visible />
            </div>
          </section>
        </footer>
      </article>

      <section aria-labelledby="titulo-relacionadas" class="mt-14 max-w-articulo border-t border-border pt-10">
        <h2 id="titulo-relacionadas" class="t-seccion">{t.relacionadas}</h2>
        <div class="mt-6 grid gap-8 md:grid-cols-3 md:gap-6">
          {relacionadas.map((relacionada) => <TarjetaRelacionada nota={relacionada} />)}
        </div>
      </section>
    </div>

    <BarraLateral notas={notas} />
  </div>
</Base>
