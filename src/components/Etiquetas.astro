---
import { rutaEtiqueta } from '../lib/rutas';

interface Props {
  etiquetas: string[];
}

const { etiquetas } = Astro.props;
---

<ul class="flex flex-wrap gap-2">
  {
    etiquetas.map((etiqueta) => (
      <li>
        <a
          href={rutaEtiqueta(etiqueta)}
          class="inline-flex min-h-11 items-center rounded-full border border-border bg-surface px-4 text-[15px] transition-colors duration-150 hover:border-accent hover:text-accent"
        >
          {etiqueta}
        </a>
      </li>
    ))
  }
</ul>
