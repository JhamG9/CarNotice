---
import { Image } from 'astro:assets';

interface Props {
  imagen?: ImageMetadata;
  alt?: string;
  /** La primera imagen de la página se carga sin diferir. */
  prioritaria?: boolean;
}

const { imagen, alt = '', prioritaria = false } = Astro.props;
---

{
  imagen ? (
    <Image
      src={imagen}
      alt={alt}
      loading={prioritaria ? 'eager' : 'lazy'}
      fetchpriority={prioritaria ? 'high' : 'auto'}
      class="aspect-video w-full bg-tint object-cover"
    />
  ) : (
    <div class="flex aspect-video w-full items-center justify-center border border-border bg-tint text-muted">
      <svg
        class="w-1/3"
        viewBox="430 240 740 360"
        fill="none"
        stroke="currentColor"
        stroke-width="12"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M520 520h-40a30 30 0 0 1-30-30v-50a40 40 0 0 1 32-39l98-21 78-82a50 50 0 0 1 36-16h212a50 50 0 0 1 39 19l66 82 107 22a40 40 0 0 1 32 39v46a30 30 0 0 1-30 30h-40" />
        <path d="M680 520h240" />
        <circle cx="600" cy="520" r="62" />
        <circle cx="1000" cy="520" r="62" />
        <path d="M600 380h400" />
      </svg>
    </div>
  )
}
