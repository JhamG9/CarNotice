---
import Base from '../../layouts/Base.astro';
import NotaDestacada from '../../components/NotaDestacada.astro';
import TarjetaNota from '../../components/TarjetaNota.astro';
import BarraLateral from '../../components/BarraLateral.astro';
import Comparador from '../../components/Comparador.tsx';
import { obtenerNotas } from '../../lib/notas';
import { rutaBlog } from '../../lib/rutas';

const notas = await obtenerNotas();
const destacada = notas.find((nota) => nota.data.destacada) ?? notas[0];
const resto = notas.filter((nota) => nota.id !== destacada.id);
---

<Base
  titulo="Garash: comparador de carros y revista"
  descripcion="Compara dos carros lado a lado: autonomía, potencia, carga, espacio y seguridad. Además, noticias, lanzamientos y carros eléctricos, en español."
  logoComoTitulo
>
  <!-- El comparador es lo principal del sitio: va primero en la portada -->
  <section aria-labelledby="titulo-comparador" class="mx-auto max-w-pagina px-4 pt-6 md:px-6 md:pt-8">
    <header class="border-b border-border pb-6">
      <h2 id="titulo-comparador" class="t-seccion barra-corta">Comparador de carros</h2>
      <p class="t-texto mt-4 max-w-articulo text-muted">
        Elige dos carros y míralos lado a lado: un resumen en gráfico, las ventajas de cada uno y la ficha técnica
        completa.
      </p>
    </header>
    <div class="pt-8">
      <Comparador client:load />
      <noscript>
        <p class="t-texto text-muted">El comparador necesita JavaScript para cargar los carros.</p>
      </noscript>
    </div>
  </section>

  <div
    class="mx-auto mt-16 grid max-w-pagina gap-12 border-t border-border px-4 pt-10 md:px-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-10 xl:gap-14"
  >
    <div class="min-w-0">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 class="t-seccion barra-corta">Blog y noticias</h2>
        <a href={rutaBlog()} class="enlace inline-flex min-h-11 items-center gap-2 text-[15px] font-bold text-accent">
          Ver todas las notas
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 8h12M9 3l5 5-5 5" />
          </svg>
        </a>
      </div>

      <NotaDestacada nota={destacada} nivel="h3" />

      <div class="mt-10">
        {resto.slice(0, 6).map((nota) => <TarjetaNota nota={nota} />)}
      </div>
    </div>

    <BarraLateral notas={notas} />
  </div>
</Base>
