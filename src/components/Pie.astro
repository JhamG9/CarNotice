---
import { categorias, textoCategoria } from '../data/categorias';
import { idiomaDe, textos } from '../i18n';
import { rutaAvisoLegal, rutaCarros, rutaCategoria, rutaComparador, rutaInicio, rutaNosotros, rutaPrivacidad } from '../lib/rutas';

const idioma = idiomaDe(Astro.url);
const t = textos(idioma).pie;
const anio = new Date().getFullYear();
const paginasCarros = [
  { nombre: t.fichas, href: rutaCarros(idioma) },
  { nombre: t.comparador, href: rutaComparador(idioma) },
];
const paginasSitio = [
  { nombre: t.nosotros, href: rutaNosotros(idioma) },
  { nombre: t.avisoLegal, href: rutaAvisoLegal(idioma) },
  { nombre: t.privacidad, href: rutaPrivacidad(idioma) },
  { nombre: t.cookies, href: `${rutaPrivacidad(idioma)}#cookies` },
];
---

<footer class="mt-16 border-t border-border bg-surface">
  <div class="mx-auto grid max-w-pagina gap-8 px-4 py-10 md:grid-cols-[2fr_1fr_1fr_1fr] md:px-6">
    <div>
      <p class="font-titular text-[24px] leading-none font-bold">
        <a href={rutaInicio(idioma)} class="inline-flex min-h-11 items-center">
          Mejor Eléctrico<span class="text-accent-bright" aria-hidden="true">.</span>
        </a>
      </p>
      <p class="mt-2 max-w-[46ch] text-muted">
        {t.lema}
      </p>
    </div>

    <nav aria-label={t.carrosAria}>
      <h2 class="t-menu text-muted">{t.carros}</h2>
      <ul class="mt-2">
        {
          paginasCarros.map((pagina) => (
            <li>
              <a href={pagina.href} class="enlace flex min-h-11 items-center">
                {pagina.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label={t.categoriasAria}>
      <h2 class="t-menu text-muted">{t.categorias}</h2>
      <ul class="mt-2">
        {
          categorias.map((categoria) => (
            <li>
              <a href={rutaCategoria(categoria, 1, idioma)} class="enlace flex min-h-11 items-center">
                {textoCategoria(categoria, idioma).nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label={t.sitio}>
      <h2 class="t-menu text-muted">{t.sitio}</h2>
      <ul class="mt-2">
        {
          paginasSitio.map((pagina) => (
            <li>
              <a href={pagina.href} class="enlace flex min-h-11 items-center">
                {pagina.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-border">
    <p class="t-meta mx-auto max-w-pagina px-4 py-4 text-muted md:px-6">
      © {anio} Mejor Eléctrico. {t.derechos}
    </p>
  </div>
</footer>
