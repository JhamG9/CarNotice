---
import { SECCIONES, formatearValor, valorDe, type Vehiculo } from '../lib/vehiculos';

/** Ficha técnica de una sola versión, por secciones. Solo las filas con dato. */
interface Props {
  vehiculo: Vehiculo;
}

const { vehiculo } = Astro.props;
const secciones = SECCIONES.map((seccion) => ({
  ...seccion,
  filas: seccion.filas
    .map((fila) => ({ fila, texto: formatearValor(fila, valorDe(fila, vehiculo)) }))
    .filter(({ texto }) => texto !== null),
})).filter((seccion) => seccion.filas.length > 0);
---

<div class="grid gap-x-10 md:grid-cols-2">
  {
    secciones.map((seccion) => (
      <div class="mt-6">
        <h4 class="font-titular text-[17px] leading-6 font-bold text-heading">{seccion.titulo}</h4>
        <dl class="mt-2">
          {seccion.filas.map(({ fila, texto }) => (
            <div class="flex justify-between gap-4 border-b border-border py-2.5 text-[16px] leading-6">
              <dt class="text-muted">{fila.etiqueta}</dt>
              <dd class="text-right tabular-nums">{texto}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))
  }
</div>
