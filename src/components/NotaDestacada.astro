---
import { Image } from 'astro:assets';
import EtiquetaCategoria from './EtiquetaCategoria.astro';
import type { Nota } from '../lib/notas';
import { fechaISO, formatearFecha } from '../lib/fechas';
import { rutaNota } from '../lib/rutas';

interface Props {
  nota: Nota;
}

const { nota } = Astro.props;
const { titulo, resumen, fecha, categoria, imagen, imagenAlt } = nota.data;
---

<article class="group relative border-b border-border pb-8">
  <Image
    src={imagen}
    alt={imagenAlt}
    loading="eager"
    fetchpriority="high"
    class="aspect-video w-full bg-border object-cover"
  />
  <div class="mt-4">
    <EtiquetaCategoria clave={categoria} />
    <h2 class="t-tarjeta md:t-articulo mt-1">
      <a href={rutaNota(nota.id)} class="enlace after:absolute after:inset-0">
        {titulo}
      </a>
    </h2>
    <p class="t-texto mt-3 text-muted">{resumen}</p>
    <time datetime={fechaISO(fecha)} class="t-meta mt-3 block text-muted">{formatearFecha(fecha)}</time>
  </div>
</article>
