---
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import type { ClaveCategoria } from '../data/categorias';
import { IDIOMAS, LOCALE, OG_LOCALE, idiomaDe, textos, type Idioma } from '../i18n';
import { rutaInicio } from '../lib/rutas';

interface Props {
  titulo: string;
  descripcion: string;
  logoComoTitulo?: boolean;
  /** Categoría a marcar en el menú cuando no se deduce de la URL (p. ej. en un artículo). */
  seccionActiva?: ClaveCategoria;
  /** Tipo Open Graph: "website" en listados, "article" en notas. */
  tipo?: 'website' | 'article';
  /** URL absoluta de la imagen para compartir. */
  imagenSocial?: string;
  /** Páginas que no deben indexarse (404): llevan noindex y no declaran URL canónica. */
  sinIndexar?: boolean;
  /** Páginas reales que Google no debe indexar por ahora (etiquetas con pocas notas, comparaciones): llevan "noindex, follow" y salen del sitemap, pero cuentan visitas. */
  noIndexar?: boolean;
  /** Ruta de esta misma página en cada idioma en que existe (incluida esta). Con dos o más, se declaran con hreflang. */
  alternativas?: Partial<Record<Idioma, string>>;
}

const {
  titulo,
  descripcion,
  logoComoTitulo = false,
  seccionActiva,
  tipo = 'website',
  imagenSocial,
  sinIndexar = false,
  noIndexar = false,
  alternativas = {},
} = Astro.props;
const idioma = idiomaDe(Astro.url);
const t = textos(idioma);
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const indexable = !sinIndexar && !noIndexar;
const absoluta = (ruta: string) => new URL(ruta, Astro.site).href;
// Traducciones de la página. x-default apunta al inglés cuando existe: es la versión para el resto del mundo.
const traducciones = IDIOMAS.filter((codigo) => alternativas[codigo]).map((codigo) => ({ codigo, href: absoluta(alternativas[codigo]!) }));
const conTraducciones = traducciones.length > 1;
const xDefault = conTraducciones ? (traducciones.find((tr) => tr.codigo === 'en') ?? traducciones[0]).href : canonica;
// El selector de idioma lleva a esta página en el otro idioma o, si no existe, a su portada.
const otro: Idioma = idioma === 'es' ? 'en' : 'es';
const enlaceOtroIdioma = alternativas[otro] ?? rutaInicio(otro);

// Google Analytics. Solo se incluye en el sitio compilado, no en el servidor de desarrollo.
const ID_ANALYTICS = 'G-3C05L6ZDMJ';
const conAnalytics = import.meta.env.PROD && !sinIndexar;
---

<!doctype html>
<html lang={LOCALE[idioma]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {sinIndexar && <meta name="robots" content="noindex" />}
    {noIndexar && !sinIndexar && <meta name="robots" content="noindex, follow" />}
    {indexable && <link rel="canonical" href={canonica} />}
    {/* Fotos grandes en Google Discover y en las búsquedas de imágenes */}
    {indexable && <meta name="robots" content="max-image-preview:large" />}
    {/* Cada página declara sus traducciones; sin traducción, solo la suya */}
    {indexable && !conTraducciones && <link rel="alternate" hreflang={LOCALE[idioma]} href={canonica} />}
    {indexable && conTraducciones && traducciones.map((tr) => <link rel="alternate" hreflang={LOCALE[tr.codigo]} href={tr.href} />)}
    {indexable && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <meta property="og:type" content={tipo} />
    {!sinIndexar && <meta property="og:url" content={canonica} />}
    <meta property="og:site_name" content="Mejor Eléctrico" />
    <meta property="og:locale" content={OG_LOCALE[idioma]} />
    {conTraducciones && traducciones.filter((tr) => tr.codigo !== idioma).map((tr) => <meta property="og:locale:alternate" content={OG_LOCALE[tr.codigo]} />)}
    {imagenSocial && <meta property="og:image" content={imagenSocial} />}
    <meta name="twitter:card" content={imagenSocial ? 'summary_large_image' : 'summary'} />
    <slot name="head" />
    <meta name="theme-color" content="#F7F6F2" />
    <!-- Aplica el tema guardado antes del primer pintado, para que no parpadee -->
    <script is:inline>
      try {
        if (localStorage.getItem('tema') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#0F1114');
        }
      } catch (e) {}
    </script>
    {
      conAnalytics && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ID_ANALYTICS}`} />
          <script is:inline define:vars={{ ID_ANALYTICS }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            // define:vars envuelve el script en una función; gtag se expone para poder registrar eventos después
            window.gtag = gtag;
            gtag('js', new Date());
            // Solo cuenta visitas en el dominio real, no en localhost ni en las direcciones de prueba de Cloudflare
            if (/(^|\.)mejorelectrico\.com$/.test(location.hostname)) gtag('config', ID_ANALYTICS);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a
      href="#contenido"
      class="t-menu sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-accent focus:px-4 focus:py-3 focus:text-on-accent"
    >
      {t.saltarAlContenido}
    </a>
    <Cabecera logoComoTitulo={logoComoTitulo} seccionActiva={seccionActiva} enlaceOtroIdioma={enlaceOtroIdioma} />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
  </body>
</html>
