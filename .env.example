# Copia este archivo como .env y completa los valores. El .env no se sube a git.

# Proyecto de Supabase de Mejor Eléctrico (en Supabase se llama "garash"). Es el único proyecto que usa este sitio.
SUPABASE_PROJECT_REF=
PUBLIC_SUPABASE_URL=

# Clave publicable (sb_publishable_...). Es pública por diseño: va al navegador.
# Lo que protege los datos son las políticas de seguridad por fila (RLS), no esta clave.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nunca pongas aquí la clave secreta (sb_secret_... o service_role) ni la contraseña de la base de datos.

# Publicación de reels en Facebook e Instagram. Los llena .claude/skills/jham-reels/scripts/meta-token.mjs.
# META_PAGE_TOKEN permite publicar en las dos cuentas: no se pega en el chat ni se sube a git.
META_APP_ID=
META_PAGE_ID=
META_IG_ID=
META_PAGE_TOKEN=

# Publicación de Shorts en YouTube (canal @mejorelectrico). Los llena .claude/skills/jham-reels/scripts/youtube-token.mjs.
# El token de renovación permite subir vídeos al canal: no se pega en el chat ni se sube a git.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
